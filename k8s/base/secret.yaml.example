apiVersion: v1
kind: Secret
metadata:
  name: grainlab-secret
type: Opaque
stringData:
  POSTGRES_USER: "grainlab_user"
  POSTGRES_PASSWORD: "change-me-to-a-secure-database-password"
  SECRET_KEY: "change-me-to-a-secure-random-secret-key-for-production"
  SUPERUSER_USERNAME: "admin"
  SUPERUSER_EMAIL: "admin@example.com"
  SUPERUSER_PASSWORD: "change-me-to-a-secure-admin-password"
