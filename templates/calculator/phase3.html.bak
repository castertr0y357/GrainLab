{% extends 'calculator/phase_base.html' %}
{% load static %}

{% block title %}Phase 3: Configuration & Ingredients - GrainLab{% endblock %}

{% block phase_x_data %}
x-data="phase3App({
    current_phase: 3,
    selected_master: '{{ state.selected_master|escapejs }}',
    global_ai_enabled: {{ state.global_ai_enabled|yesno:"true,false" }},
    enginesArchetypes: JSON.parse('{{ engines_archetypes_json|escapejs }}' || '{}'),
    engines_ff: JSON.parse('{{ engines_ff_json|escapejs }}' || '{}'),
    
    hydration: {{ state.hydration|default:70 }},
    fat: {{ state.fat|default:0 }},
    sugar: {{ state.sugar|default:0 }},
    starter: {{ state.starter|default:20 }},
    
    mill_type: '{{ state.mill_type|default:""|escapejs }}',
    is_sifted: {{ state.is_sifted|yesno:"true,false" }},
    custom_mixer: '{{ state.custom_mixer|default:""|escapejs }}',
    
    // We need selected recipe info to display the right secondary ingredients if applicable.
    selectedRecipeSecondaryIngredients: JSON.parse('{{ state.secondary_ingredients|default:"{}"|escapejs }}'),
    recipe_name: '{{ state.recipe_name|default:""|escapejs }}',
    preset_slug: '{{ state.preset_slug|default:""|escapejs }}',
    active_berries: JSON.parse('{{ active_berries_json|default:"[]"|escapejs }}'),
    flavor_inclusions: JSON.parse('{{ state.flavor_inclusions|default:"[]"|escapejs }}')
})"
{% endblock %}

{% block phase_x_init %}
x-init="init()"
{% endblock %}

{% block phase_left_panel %}
    <!-- PHASE 3: Core Configuration -->
    <div x-show="current_phase === 3" x-transition style="position: relative;">
        <div x-show="phase3Loading" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(18, 18, 23, 0.85); z-index: 50; display: flex; flex-direction: column; align-items: center; justify-content: center; backdrop-filter: blur(4px); border-radius: var(--radius-md);">
            <div class="spinner" style="width: 50px; height: 50px; border-top-color: var(--accent); margin-bottom: 1.5rem;"></div>
            <div style="color: var(--accent); font-weight: 600; font-size: 1.1rem; letter-spacing: 0.05em; text-align: center; text-transform: uppercase; margin-bottom: 2rem;" x-text="phase3LoadingMessage"></div>
            <div style="width: 100%; max-width: 400px; display: flex; flex-direction: column; gap: 0.75rem;">
                <template x-for="step in phase3_generation_steps">
                    <div style="display: flex; align-items: center; gap: 1rem; padding: 0.75rem; background: rgba(0,0,0,0.3); border-radius: var(--radius-sm); border: 1px solid rgba(255,255,255,0.05);">
                        <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                            <template x-if="step.completed">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4caf50" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            </template>
                            <template x-if="step.active">
                                <div class="spinner" style="width: 16px; height: 16px; border-width: 2px;"></div>
                            </template>
                            <template x-if="!step.completed && !step.active">
                                <div style="width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--text-muted);"></div>
                            </template>
                        </div>
                        <div style="font-size: 0.9rem;" :style="step.completed ? 'color: var(--text-primary);' : (step.active ? 'color: var(--accent); font-weight: 600;' : 'color: var(--text-muted);')" x-text="step.text"></div>
                    </div>
                </template>
            </div>
        </div>

        <div style="display: block; margin-bottom: 1.25rem; font-weight: 600; font-size: 1.15rem; color: var(--accent); text-transform: uppercase; letter-spacing: 0.05em;">
            Phase 3: Core Configuration
        </div>

        {% if state.is_tweaking %}
        <div style="background-color: rgba(129, 199, 132, 0.1); border-left: 4px solid var(--success); padding: 0.75rem 1rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem;">
            <h4 style="color: var(--success); margin: 0 0 0.25rem 0; font-weight: 700; font-size: 0.85rem; text-transform: uppercase;">🛠️ Tweak Mode Active</h4>
            <p style="font-size: 0.8rem; color: var(--text-primary); margin: 0; line-height: 1.4;">
                You are tweaking a saved formula. Grain selections are locked. Adjust your hydration and configuration below to generate a new iteration!
            </p>
        </div>
        {% endif %}
        
        <!-- Component 1: Secondary Ingredient Configuration Deck -->
        <div class="card" style="padding: 1.25rem; background-color: var(--bg-card); margin-bottom: 1.5rem;"
             x-show="(selectedRecipeSecondaryIngredients && Object.keys(selectedRecipeSecondaryIngredients).length > 0) || (engines_ff?.[selected_master]?.secondary_ingredients && Object.keys(engines_ff?.[selected_master].secondary_ingredients).length > 0)">
            <h4 style="font-size: 1.05rem; margin-bottom: 1.25rem; color: var(--accent); font-weight: 600;">Secondary Ingredients</h4>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem;">
                
                <!-- Lipids Selector -->
                <div x-show="(selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.lipids) || (engines_ff?.[selected_master]?.secondary_ingredients && engines_ff?.[selected_master].secondary_ingredients.lipids)" 
                     style="display: flex; flex-direction: column; gap: 0.75rem;"
                     @mouseenter="setHoveredElement('secondary_lipid')"
                     @mouseleave="clearHoveredElement()"
                     @focusin="setHoveredElement('secondary_lipid')"
                     @focusout="clearHoveredElement()">
                    <label style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.25rem;">Fat / Lipid Category</label>
                    <input type="hidden" name="secondary_lipid_category" :value="secondary_lipid_category">
                    <input type="hidden" name="secondary_lipid_option" :value="secondary_lipid_option">
                    <input type="hidden" name="secondary_lipid_temp" :value="secondary_lipid_temp">
                    
                    <div class="pill-btn-group">
                        <template x-for="cat in ((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.lipids) ? selectedRecipeSecondaryIngredients.lipids.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.lipids?.categories || []))" :key="cat.name">
                            <button type="button" class="pill-btn" :class="secondary_lipid_category === cat.name ? 'active' : ''"
                                    @click="
                                        secondary_lipid_category = cat.name;
                                        if (cat.options.length > 0) {
                                            secondary_lipid_option = cat.options[0].name;
                                            secondary_lipid_temp = cat.options[0].temperature_options.length > 0 ? cat.options[0].temperature_options[0] : 'N/A';
                                        }
                                        $nextTick
                                    ">
                                <span x-text="cat.name.replace(/_/g, ' ')"></span>
                            </button>
                        </template>
                    </div>

                    <!-- Lipid Options within Category -->
                    <div x-show="secondary_lipid_category !== 'None' && ((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.lipids) ? selectedRecipeSecondaryIngredients.lipids.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.lipids?.categories || [])).find(c => c.name === secondary_lipid_category)?.options?.length > 0" 
                         style="margin-left: 1rem; border-left: 2px solid rgba(255,255,255,0.1); padding-left: 1rem; margin-top: 0.25rem; display: flex; flex-direction: column; gap: 0.5rem;">
                        <label style="font-size: 0.75rem; color: var(--text-secondary); font-weight: 600; text-transform: uppercase;">Specific Option</label>
                        <div class="pill-btn-group" style="gap: 0.25rem;">
                            <template x-for="opt in ((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.lipids) ? selectedRecipeSecondaryIngredients.lipids.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.lipids?.categories || [])).find(c => c.name === secondary_lipid_category)?.options || []" :key="opt.name">
                                <button type="button" class="pill-btn" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;" :class="secondary_lipid_option === opt.name ? 'active' : ''"
                                        @click="
                                            secondary_lipid_option = opt.name;
                                            secondary_lipid_temp = opt.temperature_options.length > 0 ? opt.temperature_options[0] : 'N/A';
                                            $nextTick
                                        ">
                                    <span x-text="opt.name.replace(/_/g, ' ')"></span>
                                </button>
                            </template>
                        </div>
                        
                        <!-- Lipid Temperature -->
                        <div x-show="((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.lipids) ? selectedRecipeSecondaryIngredients.lipids.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.lipids?.categories || [])).find(c => c.name === secondary_lipid_category)?.options?.find(o => o.name === secondary_lipid_option)?.temperature_options?.length > 0" 
                             style="margin-top: 0.25rem; display: flex; flex-direction: column; gap: 0.25rem;">
                            <label style="font-size: 0.75rem; color: var(--text-secondary); font-weight: 600; text-transform: uppercase;">Temperature Target</label>
                            <div class="pill-btn-group" style="gap: 0.25rem;">
                                <template x-for="temp in ((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.lipids) ? selectedRecipeSecondaryIngredients.lipids.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.lipids?.categories || [])).find(c => c.name === secondary_lipid_category)?.options?.find(o => o.name === secondary_lipid_option)?.temperature_options || []" :key="temp">
                                    <button type="button" class="pill-btn" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;" :class="secondary_lipid_temp === temp ? 'active' : ''"
                                            @click="secondary_lipid_temp = temp; $nextTick">
                                        <span x-text="temp"></span>
                                    </button>
                                </template>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Liquids Selector -->
                <div x-show="(selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.liquids) || (engines_ff?.[selected_master]?.secondary_ingredients && engines_ff?.[selected_master].secondary_ingredients.liquids)" 
                     style="display: flex; flex-direction: column; gap: 0.75rem;"
                     @mouseenter="setHoveredElement('secondary_liquid')"
                     @mouseleave="clearHoveredElement()"
                     @focusin="setHoveredElement('secondary_liquid')"
                     @focusout="clearHoveredElement()">
                    <label style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.25rem;">Liquid Medium Category</label>
                    <input type="hidden" name="secondary_liquid_category" :value="secondary_liquid_category">
                    <input type="hidden" name="secondary_liquid_option" :value="secondary_liquid_option">
                    <input type="hidden" name="secondary_liquid_temp" :value="secondary_liquid_temp">
                    
                    <div class="pill-btn-group">
                        <template x-for="cat in ((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.liquids) ? selectedRecipeSecondaryIngredients.liquids.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.liquids?.categories || []))" :key="cat.name">
                            <button type="button" class="pill-btn" :class="secondary_liquid_category === cat.name ? 'active' : ''"
                                    @click="
                                        secondary_liquid_category = cat.name;
                                        if (cat.options.length > 0) {
                                            secondary_liquid_option = cat.options[0].name;
                                            secondary_liquid_temp = cat.options[0].temperature_options.length > 0 ? cat.options[0].temperature_options[0] : 'N/A';
                                        }
                                        $nextTick
                                    ">
                                <span x-text="cat.name.replace(/_/g, ' ')"></span>
                            </button>
                        </template>
                    </div>

                    <!-- Liquid Options within Category -->
                    <div x-show="secondary_liquid_category !== 'None' && ((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.liquids) ? selectedRecipeSecondaryIngredients.liquids.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.liquids?.categories || [])).find(c => c.name === secondary_liquid_category)?.options?.length > 0" 
                         style="margin-left: 1rem; border-left: 2px solid rgba(255,255,255,0.1); padding-left: 1rem; margin-top: 0.25rem; display: flex; flex-direction: column; gap: 0.5rem;">
                        <label style="font-size: 0.75rem; color: var(--text-secondary); font-weight: 600; text-transform: uppercase;">Specific Option</label>
                        <div class="pill-btn-group" style="gap: 0.25rem;">
                            <template x-for="opt in ((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.liquids) ? selectedRecipeSecondaryIngredients.liquids.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.liquids?.categories || [])).find(c => c.name === secondary_liquid_category)?.options || []" :key="opt.name">
                                <button type="button" class="pill-btn" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;" :class="secondary_liquid_option === opt.name ? 'active' : ''"
                                        @click="
                                            secondary_liquid_option = opt.name;
                                            secondary_liquid_temp = opt.temperature_options.length > 0 ? opt.temperature_options[0] : 'N/A';
                                            $nextTick
                                        ">
                                    <span x-text="opt.name.replace(/_/g, ' ')"></span>
                                </button>
                            </template>
                        </div>
                        
                        <!-- Liquid Temperature -->
                        <div x-show="((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.liquids) ? selectedRecipeSecondaryIngredients.liquids.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.liquids?.categories || [])).find(c => c.name === secondary_liquid_category)?.options?.find(o => o.name === secondary_liquid_option)?.temperature_options?.length > 0" 
                             style="margin-top: 0.25rem; display: flex; flex-direction: column; gap: 0.25rem;">
                            <label style="font-size: 0.75rem; color: var(--text-secondary); font-weight: 600; text-transform: uppercase;">Temperature Target</label>
                            <div class="pill-btn-group" style="gap: 0.25rem;">
                                <template x-for="temp in ((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.liquids) ? selectedRecipeSecondaryIngredients.liquids.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.liquids?.categories || [])).find(c => c.name === secondary_liquid_category)?.options?.find(o => o.name === secondary_liquid_option)?.temperature_options || []" :key="temp">
                                    <button type="button" class="pill-btn" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;" :class="secondary_liquid_temp === temp ? 'active' : ''"
                                            @click="secondary_liquid_temp = temp; $nextTick">
                                        <span x-text="temp"></span>
                                    </button>
                                </template>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Binders Selector -->
                <div x-show="(selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.binders) || (engines_ff?.[selected_master]?.secondary_ingredients && engines_ff?.[selected_master].secondary_ingredients.binders)" 
                     style="display: flex; flex-direction: column; gap: 0.75rem;"
                     @mouseenter="setHoveredElement('secondary_binder')"
                     @mouseleave="clearHoveredElement()"
                     @focusin="setHoveredElement('secondary_binder')"
                     @focusout="clearHoveredElement()">
                    <label style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.25rem;">Binder Category</label>
                    <input type="hidden" name="secondary_binder_category" :value="secondary_binder_category">
                    <input type="hidden" name="secondary_binder_option" :value="secondary_binder_option">
                    <input type="hidden" name="secondary_binder_temp" :value="secondary_binder_temp">
                    
                    <div class="pill-btn-group">
                        <template x-for="cat in ((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.binders) ? selectedRecipeSecondaryIngredients.binders.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.binders?.categories || []))" :key="cat.name">
                            <button type="button" class="pill-btn" :class="secondary_binder_category === cat.name ? 'active' : ''"
                                    @click="
                                        secondary_binder_category = cat.name;
                                        if (cat.options.length > 0) {
                                            secondary_binder_option = cat.options[0].name;
                                            secondary_binder_temp = cat.options[0].temperature_options.length > 0 ? cat.options[0].temperature_options[0] : 'N/A';
                                        }
                                        $nextTick
                                    ">
                                <span x-text="cat.name.replace(/_/g, ' ')"></span>
                            </button>
                        </template>
                    </div>

                    <!-- Binder Options within Category -->
                    <div x-show="secondary_binder_category !== 'None' && ((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.binders) ? selectedRecipeSecondaryIngredients.binders.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.binders?.categories || [])).find(c => c.name === secondary_binder_category)?.options?.length > 0" 
                         style="margin-left: 1rem; border-left: 2px solid rgba(255,255,255,0.1); padding-left: 1rem; margin-top: 0.25rem; display: flex; flex-direction: column; gap: 0.5rem;">
                        <label style="font-size: 0.75rem; color: var(--text-secondary); font-weight: 600; text-transform: uppercase;">Specific Option</label>
                        <div class="pill-btn-group" style="gap: 0.25rem;">
                            <template x-for="opt in ((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.binders) ? selectedRecipeSecondaryIngredients.binders.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.binders?.categories || [])).find(c => c.name === secondary_binder_category)?.options || []" :key="opt.name">
                                <button type="button" class="pill-btn" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;" :class="secondary_binder_option === opt.name ? 'active' : ''"
                                        @click="
                                            secondary_binder_option = opt.name;
                                            secondary_binder_temp = opt.temperature_options.length > 0 ? opt.temperature_options[0] : 'N/A';
                                            $nextTick
                                        ">
                                    <span x-text="opt.name.replace(/_/g, ' ')"></span>
                                </button>
                            </template>
                        </div>
                        
                        <!-- Binder Temperature -->
                        <div x-show="((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.binders) ? selectedRecipeSecondaryIngredients.binders.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.binders?.categories || [])).find(c => c.name === secondary_binder_category)?.options?.find(o => o.name === secondary_binder_option)?.temperature_options?.length > 0" 
                             style="margin-top: 0.25rem; display: flex; flex-direction: column; gap: 0.25rem;">
                            <label style="font-size: 0.75rem; color: var(--text-secondary); font-weight: 600; text-transform: uppercase;">Temperature Target</label>
                            <div class="pill-btn-group" style="gap: 0.25rem;">
                                <template x-for="temp in ((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.binders) ? selectedRecipeSecondaryIngredients.binders.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.binders?.categories || [])).find(c => c.name === secondary_binder_category)?.options?.find(o => o.name === secondary_binder_option)?.temperature_options || []" :key="temp">
                                    <button type="button" class="pill-btn" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;" :class="secondary_binder_temp === temp ? 'active' : ''"
                                            @click="secondary_binder_temp = temp; $nextTick">
                                        <span x-text="temp"></span>
                                    </button>
                                </template>
                            </div>
                        </div>
                    </div>
                </div>

        <!-- Sweeteners Selector -->
        <div x-show="(selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.sweeteners) || (engines_ff?.[selected_master]?.secondary_ingredients && engines_ff?.[selected_master].secondary_ingredients.sweeteners)" 
             style="display: flex; flex-direction: column; gap: 0.75rem;"
             @mouseenter="setHoveredElement('secondary_sweetener')"
             @mouseleave="clearHoveredElement()"
             @focusin="setHoveredElement('secondary_sweetener')"
             @focusout="clearHoveredElement()">
            <label style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.25rem;">Sweeteners Category</label>
            <input type="hidden" name="secondary_sweetener_category" :value="secondary_sweetener_category">
            <input type="hidden" name="secondary_sweetener_option" :value="secondary_sweetener_option">
            <input type="hidden" name="secondary_sweetener_temp" :value="secondary_sweetener_temp">
            
            <div class="pill-btn-group">
                <template x-for="cat in ((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.sweeteners) ? selectedRecipeSecondaryIngredients.sweeteners.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.sweeteners?.categories || []))" :key="cat.name">
                    <button type="button" class="pill-btn" :class="secondary_sweetener_category === cat.name ? 'active' : ''"
                            @click="
                                secondary_sweetener_category = cat.name;
                                if (cat.options.length > 0) {
                                    secondary_sweetener_option = cat.options[0].name;
                                    secondary_sweetener_temp = cat.options[0].temperature_options.length > 0 ? cat.options[0].temperature_options[0] : 'N/A';
                                }
                                $nextTick
                            ">
                        <span x-text="cat.name.replace(/_/g, ' ')"></span>
                    </button>
                </template>
            </div>

            <!-- Sweetener Options within Category -->
            <div x-show="secondary_sweetener_category !== 'None' && ((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.sweeteners) ? selectedRecipeSecondaryIngredients.sweeteners.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.sweeteners?.categories || [])).find(c => c.name === secondary_sweetener_category)?.options?.length > 0" 
                 style="margin-left: 1rem; border-left: 2px solid rgba(255,255,255,0.1); padding-left: 1rem; margin-top: 0.25rem; display: flex; flex-direction: column; gap: 0.5rem;">
                <label style="font-size: 0.75rem; color: var(--text-secondary); font-weight: 600; text-transform: uppercase;">Specific Option</label>
                <div class="pill-btn-group" style="gap: 0.25rem;">
                    <template x-for="opt in ((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.sweeteners) ? selectedRecipeSecondaryIngredients.sweeteners.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.sweeteners?.categories || [])).find(c => c.name === secondary_sweetener_category)?.options || []" :key="opt.name">
                        <button type="button" class="pill-btn" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;" :class="secondary_sweetener_option === opt.name ? 'active' : ''"
                                @click="
                                    secondary_sweetener_option = opt.name;
                                    secondary_sweetener_temp = opt.temperature_options.length > 0 ? opt.temperature_options[0] : 'N/A';
                                    $nextTick
                                ">
                            <span x-text="opt.name.replace(/_/g, ' ')"></span>
                        </button>
                    </template>
                </div>
                
                <!-- Sweetener Temperature -->
                <div x-show="((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.sweeteners) ? selectedRecipeSecondaryIngredients.sweeteners.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.sweeteners?.categories || [])).find(c => c.name === secondary_sweetener_category)?.options?.find(o => o.name === secondary_sweetener_option)?.temperature_options?.length > 0" 
                     style="margin-top: 0.25rem; display: flex; flex-direction: column; gap: 0.25rem;">
                    <label style="font-size: 0.75rem; color: var(--text-secondary); font-weight: 600; text-transform: uppercase;">Temperature Target</label>
                    <div class="pill-btn-group" style="gap: 0.25rem;">
                        <template x-for="temp in ((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.sweeteners) ? selectedRecipeSecondaryIngredients.sweeteners.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.sweeteners?.categories || [])).find(c => c.name === secondary_sweetener_category)?.options?.find(o => o.name === secondary_sweetener_option)?.temperature_options || []" :key="temp">
                            <button type="button" class="pill-btn" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;" :class="secondary_sweetener_temp === temp ? 'active' : ''"
                                    @click="secondary_sweetener_temp = temp; $nextTick">
                                <span x-text="temp"></span>
                            </button>
                        </template>
                    </div>
                </div>
            </div>
            </div>

            <!-- Leaveners Selector -->
            <div x-show="(selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.leaveners) || (engines_ff?.[selected_master]?.secondary_ingredients && engines_ff?.[selected_master].secondary_ingredients.leaveners)" 
                 style="display: flex; flex-direction: column; gap: 0.75rem;"
                 @mouseenter="setHoveredElement('secondary_leavener')"
                 @mouseleave="clearHoveredElement()"
                 @focusin="setHoveredElement('secondary_leavener')"
                 @focusout="clearHoveredElement()">
                <label style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.25rem;">Leaveners Category</label>
                <input type="hidden" name="secondary_leavener_category" :value="secondary_leavener_category">
                <input type="hidden" name="secondary_leavener_option" :value="secondary_leavener_option">
                <input type="hidden" name="secondary_leavener_temp" :value="secondary_leavener_temp">
                
                <div class="pill-btn-group">
                    <template x-for="cat in ((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.leaveners) ? selectedRecipeSecondaryIngredients.leaveners.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.leaveners?.categories || []))" :key="cat.name">
                        <button type="button" class="pill-btn" :class="secondary_leavener_category === cat.name ? 'active' : ''"
                                @click="
                                    secondary_leavener_category = cat.name;
                                    if (cat.options.length > 0) {
                                        secondary_leavener_option = cat.options[0].name;
                                        secondary_leavener_temp = cat.options[0].temperature_options.length > 0 ? cat.options[0].temperature_options[0] : 'N/A';
                                    }
                                    $nextTick
                                ">
                            <span x-text="cat.name.replace(/_/g, ' ')"></span>
                        </button>
                    </template>
                </div>

                <!-- Leavener Options within Category -->
                <div x-show="secondary_leavener_category !== 'None' && ((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.leaveners) ? selectedRecipeSecondaryIngredients.leaveners.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.leaveners?.categories || [])).find(c => c.name === secondary_leavener_category)?.options?.length > 0" 
                     style="margin-left: 1rem; border-left: 2px solid rgba(255,255,255,0.1); padding-left: 1rem; margin-top: 0.25rem; display: flex; flex-direction: column; gap: 0.5rem;">
                    <label style="font-size: 0.75rem; color: var(--text-secondary); font-weight: 600; text-transform: uppercase;">Specific Option</label>
                    <div class="pill-btn-group" style="gap: 0.25rem;">
                        <template x-for="opt in ((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.leaveners) ? selectedRecipeSecondaryIngredients.leaveners.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.leaveners?.categories || [])).find(c => c.name === secondary_leavener_category)?.options || []" :key="opt.name">
                            <button type="button" class="pill-btn" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;" :class="secondary_leavener_option === opt.name ? 'active' : ''"
                                    @click="
                                        secondary_leavener_option = opt.name;
                                        secondary_leavener_temp = opt.temperature_options.length > 0 ? opt.temperature_options[0] : 'N/A';
                                        $nextTick
                                    ">
                                <span x-text="opt.name.replace(/_/g, ' ')"></span>
                            </button>
                        </template>
                    </div>
                    
                    <!-- Leavener Temperature -->
                    <div x-show="((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.leaveners) ? selectedRecipeSecondaryIngredients.leaveners.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.leaveners?.categories || [])).find(c => c.name === secondary_leavener_category)?.options?.find(o => o.name === secondary_leavener_option)?.temperature_options?.length > 0" 
                         style="margin-top: 0.25rem; display: flex; flex-direction: column; gap: 0.25rem;">
                        <label style="font-size: 0.75rem; color: var(--text-secondary); font-weight: 600; text-transform: uppercase;">Temperature Target</label>
                        <div class="pill-btn-group" style="gap: 0.25rem;">
                            <template x-for="temp in ((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.leaveners) ? selectedRecipeSecondaryIngredients.leaveners.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.leaveners?.categories || [])).find(c => c.name === secondary_leavener_category)?.options?.find(o => o.name === secondary_leavener_option)?.temperature_options || []" :key="temp">
                                <button type="button" class="pill-btn" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;" :class="secondary_leavener_temp === temp ? 'active' : ''"
                                        @click="secondary_leavener_temp = temp; $nextTick">
                                    <span x-text="temp"></span>
                                </button>
                            </template>
                        </div>
                    </div>
                </div>
            </div>
            </div>
            
            <!-- Additives Selector -->
            <div x-show="(selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.additives) || (engines_ff?.[selected_master]?.secondary_ingredients && engines_ff?.[selected_master].secondary_ingredients.additives)" 
                 style="display: flex; flex-direction: column; gap: 0.75rem;"
                 @mouseenter="setHoveredElement('secondary_additive')"
                 @mouseleave="clearHoveredElement()"
                 @focusin="setHoveredElement('secondary_additive')"
                 @focusout="clearHoveredElement()">
                <label style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.25rem;">Additives Category</label>
                <input type="hidden" name="secondary_additive_category" :value="secondary_additive_category">
                <input type="hidden" name="secondary_additive_option" :value="secondary_additive_option">
                <input type="hidden" name="secondary_additive_temp" :value="secondary_additive_temp">
                
                <div class="pill-btn-group">
                    <template x-for="cat in ((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.additives) ? selectedRecipeSecondaryIngredients.additives.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.additives?.categories || []))" :key="cat.name">
                        <button type="button" class="pill-btn" :class="secondary_additive_category === cat.name ? 'active' : ''"
                                @click="
                                    secondary_additive_category = cat.name;
                                    if (cat.options.length > 0) {
                                        secondary_additive_option = cat.options[0].name;
                                        secondary_additive_temp = cat.options[0].temperature_options.length > 0 ? cat.options[0].temperature_options[0] : 'N/A';
                                    }
                                    $nextTick
                                ">
                            <span x-text="cat.name.replace(/_/g, ' ')"></span>
                        </button>
                    </template>
                </div>

                <!-- Additive Options within Category -->
                <div x-show="secondary_additive_category !== 'None' && ((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.additives) ? selectedRecipeSecondaryIngredients.additives.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.additives?.categories || [])).find(c => c.name === secondary_additive_category)?.options?.length > 0" 
                     style="margin-left: 1rem; border-left: 2px solid rgba(255,255,255,0.1); padding-left: 1rem; margin-top: 0.25rem; display: flex; flex-direction: column; gap: 0.5rem;">
                    <label style="font-size: 0.75rem; color: var(--text-secondary); font-weight: 600; text-transform: uppercase;">Specific Option</label>
                    <div class="pill-btn-group" style="gap: 0.25rem;">
                        <template x-for="opt in ((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.additives) ? selectedRecipeSecondaryIngredients.additives.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.additives?.categories || [])).find(c => c.name === secondary_additive_category)?.options || []" :key="opt.name">
                            <button type="button" class="pill-btn" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;" :class="secondary_additive_option === opt.name ? 'active' : ''"
                                    @click="
                                        secondary_additive_option = opt.name;
                                        secondary_additive_temp = opt.temperature_options.length > 0 ? opt.temperature_options[0] : 'N/A';
                                        $nextTick
                                    ">
                                <span x-text="opt.name.replace(/_/g, ' ')"></span>
                            </button>
                        </template>
                    </div>
                    
                    <!-- Additive Temperature -->
                    <div x-show="((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.additives) ? selectedRecipeSecondaryIngredients.additives.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.additives?.categories || [])).find(c => c.name === secondary_additive_category)?.options?.find(o => o.name === secondary_additive_option)?.temperature_options?.length > 0" 
                         style="margin-top: 0.25rem; display: flex; flex-direction: column; gap: 0.25rem;">
                        <label style="font-size: 0.75rem; color: var(--text-secondary); font-weight: 600; text-transform: uppercase;">Temperature Target</label>
                        <div class="pill-btn-group" style="gap: 0.25rem;">
                            <template x-for="temp in ((selectedRecipeSecondaryIngredients && selectedRecipeSecondaryIngredients.additives) ? selectedRecipeSecondaryIngredients.additives.categories : (engines_ff?.[selected_master]?.secondary_ingredients?.additives?.categories || [])).find(c => c.name === secondary_additive_category)?.options?.find(o => o.name === secondary_additive_option)?.temperature_options || []" :key="temp">
                                <button type="button" class="pill-btn" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;" :class="secondary_additive_temp === temp ? 'active' : ''"
                                        @click="secondary_additive_temp = temp; $nextTick">
                                    <span x-text="temp"></span>
                                </button>
                            </template>
                        </div>
                    </div>
                </div>
                </div>
            </div>
            
        </div>
    </div>

            <!-- Specialty Ingredients (Flavor Inclusions) -->
            <div class="card" style="padding: 1.25rem; background-color: var(--bg-card); margin-bottom: 1.5rem;"
                 x-show="flavor_inclusions && flavor_inclusions.length > 0">
                <h4 style="font-size: 1.05rem; margin-bottom: 1.25rem; color: var(--accent); font-weight: 600;">Specialty Ingredients</h4>
                
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem;">
                    <template x-for="item in flavor_inclusions" :key="item.name">
                        <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: var(--radius-sm); padding: 1rem; display: flex; flex-direction: column; gap: 0.5rem;"
                             @mouseenter="setHoveredElement('specialty_' + item.name)"
                             @mouseleave="clearHoveredElement()"
                             @focusin="setHoveredElement('specialty_' + item.name)"
                             @focusout="clearHoveredElement()">
                            <div style="font-weight: 600; font-size: 0.95rem; color: var(--text-primary);" x-text="item.name"></div>
                            
                            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 0.5rem; margin-top: 0.25rem;">
                                <div style="display: flex; flex-direction: column;">
                                    <span style="font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase;">Baker's %</span>
                                    <span style="font-size: 0.85rem; font-weight: 700; color: var(--text-secondary);" x-text="item.bakers_percentage + '%'"></span>
                                </div>
                                <div style="display: flex; flex-direction: column; align-items: flex-end;" x-show="item.volume_description">
                                    <span style="font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase;">Volume</span>
                                    <span style="font-size: 0.85rem; font-weight: 700; color: var(--text-secondary);" x-text="item.volume_description"></span>
                                </div>
                            </div>
                        </div>
                    </template>
                </div>
            </div>

            <!-- Proceed button -->
            <button type="button" 
                    class="nav-btn primary"
                    style="width: 100%; height: 52px; font-weight: 600; letter-spacing: 0.05em; cursor: pointer; border: 2px solid #81c784; border-radius: var(--radius-sm); background: rgba(129, 199, 132, 0.05); color: #81c784; box-shadow: 0 0 10px rgba(129, 199, 132, 0.1); transition: var(--transition); margin-top: 1.5rem;"
                    onmouseover="this.style.background='#81c784'; this.style.color='#000'; this.style.boxShadow='0 0 15px rgba(129, 199, 132, 0.3)';"
                    onmouseout="this.style.background='rgba(129, 199, 132, 0.05)'; this.style.color='#81c784'; this.style.boxShadow='0 0 10px rgba(129, 199, 132, 0.1)';"
                    @click="document.getElementById('phase3-form').submit()">
                PROCEED TO FORMULA READOUT →
            </button>
        </div>

    </div>
{% endblock %}

{% block phase_hidden_forms %}
    <form id="phase3-form" action="{% url 'calculator_phase3' category=state.selected_master archetype=state.preset_slug %}" method="POST" style="display: none;">
        {% csrf_token %}
        <input type="hidden" name="hydration_pct" :value="hydration">
        <input type="hidden" name="leaven_pct" :value="starter">
        <input type="hidden" name="fat_pct" :value="fat">
        <input type="hidden" name="sugar_pct" :value="sugar">
    </form>
{% endblock %}

{% block phase_right_panel %}
    <!-- Active Selected Recipe -->
    <div x-show="recipe_name" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1rem; margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem;">
        <div style="font-size: 0.75rem; color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">Selected Formula</div>
        <div style="font-size: 1.05rem; font-weight: 600; color: var(--text-primary);" x-text="recipe_name"></div>
    </div>

    <!-- Panel B: Pragmatic Magic Layer (AIInsightCard for non-grain items when AI active) -->
    <div x-show="global_ai_enabled && hovered_element && !hovered_element.startsWith('grain_')" style="background-color: #1a1a1f; padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid rgba(255, 152, 0, 0.15); box-shadow: 0 0 10px rgba(255, 136, 0, 0.05);">
        <h3 style="color: #ff9800; margin: 0 0 0.75rem 0; font-size: 0.95rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid rgba(255, 136, 0, 0.1); padding-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
            🤖 Pragmatic Magic Layer
        </h3>
        
        <!-- Insight Loading State -->
        <div x-show="sidebar_insight_loading" style="display: flex; flex-direction: column; gap: 0.5rem; padding: 0.5rem 0;">
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
                <span class="spinner" style="width: 10px; height: 10px;"></span>
                <span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary);">AI Analysis Engine Active</span>
            </div>
        </div>
    </div>
{% endblock %}

{% block head_scripts %}
<script src="{% static 'js/calculator/core.js' %}"></script>
<script src="{% static 'js/calculator/phase3.js' %}"></script>
{% endblock %}
